SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/teamProject?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

MYSQL_DATABASE=teamProject
MYSQL_ROOT_PASSWORD=change-me

SERVER_PORT=8081
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=/api/v1

# NGROK
# ngrok http 5174 실행 후 아래 값을 .env에 적용하고 백엔드를 재시작합니다.
# FRONTEND_URL=https://your-domain.ngrok-free.app
# AUTH_SECURE_COOKIE=true
# SERVER_FORWARD_HEADERS_STRATEGY=framework
# NGROK

JWT_SECRET=replace-with-at-least-32-characters-local-secret
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_SECONDS=1209600
AUTH_SECURE_COOKIE=false

MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@totaskflow.local
MAIL_VERIFICATION_MINUTES=10
PASSWORD_RESET_MINUTES=30

# Placeholders only. Replace in local/AWS secret storage; never commit real credentials.
OAUTH2_GOOGLE_CLIENT_ID=googlecloudeconsole_id
OAUTH2_GOOGLE_CLIENT_SECRET=googlecloudeconsole_key
OAUTH_SIGNUP_CLEANUP_MS=900000
OAUTH2_KAKAO_CLIENT_ID=disabled
OAUTH2_KAKAO_CLIENT_SECRET=disabled

# Local development stores uploaded images here. In EC2, use a persistent mounted directory.
UPLOAD_LOCAL_ROOT=uploads
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB

# Toss Payments: never commit real values. Client key is public; secret/encryption keys are server-only.
TOSS_CLIENT_KEY=S2_013c011219974e129812d1848551691b
TOSS_SECRET_KEY=replace-with-toss-test-secret-key
# 32 random bytes, base64 encoded. Keep stable or stored billing keys cannot be decrypted.
PAYMENT_ENCRYPTION_KEY_BASE64=replace-with-openssl-rand-base64-32
TOSS_TEST_MODE=true

DEMO_ENABLED=true
DEMO_USERNAME=demo_leader

# AI weekly reports. Keep disabled until a server-side OpenAI key is configured.
AI_REPORT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT=90s
AI_REPORT_GENERATION_LEASE=4m

# Public canonical origin used for robots.txt, sitemap.xml, and canonical links.
VITE_PUBLIC_SITE_URL=http://localhost:5174
# Keep false for local, ngrok, QA, and pre-production. Set true only for approved production launch.
VITE_ALLOW_INDEXING=false
# Paste the Search Console HTML-tag verification token here for production.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_PRIVACY_CONTACT=ghrud8835@gmail.com
VITE_CONTACT_EMAIL=ghrud8835@gmail.com

# 아래 값은 backend/src/main/resources/application.properties의 기본값과 같으므로 로컬에서는
# 설정할 필요가 없다. 기본값을 바꿔야 할 때만 주석을 풀고, 코드 기본값이 바뀌면 이 목록도 함께 고친다.
# SPRING_FLYWAY_ENABLED=true
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
# SPRING_FLYWAY_BASELINE_VERSION=1
# GROUP_INVITATION_HOURS=72
# NOTIFICATION_DUE_SOON_CRON=0 */15 * * * *
# SECURITY_RATE_LIMIT_ENABLED=true
# SECURITY_RATE_LIMIT_ATTEMPTS=10
# SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
# TOSS_API_BASE=https://api.tosspayments.com
# LOG_FILE=logs/totaskflow.log
# LOG_MAX_FILE_SIZE=20MB
# LOG_MAX_HISTORY=30
# LOG_TOTAL_SIZE_CAP=1GB
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
