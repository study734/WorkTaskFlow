# Python AI 서버 설정. Spring 프록시 뒤 내부망에서만 뜬다.

AI_PORT=8090

# Spring 백엔드 내부 주소. 사용자 토큰을 그대로 실어 이 주소로 되돌려 호출한다.
AI_SPRING_BASE_URL=http://localhost:8085

# Spring 프록시만 이 서버를 부를 수 있게 하는 공유 비밀. 64바이트 랜덤 권장.
# openssl rand -base64 48
AI_INTERNAL_SECRET=

# LLM. Spring 의 AI 리포트와 같은 키를 쓴다.
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small

# 비활성 상태에서는 모든 엔드포인트가 503 을 반환한다.
AI_ENABLED=false

# 영속 볼륨. 재시작해도 승인 대기와 색인이 살아남아야 한다.
AI_CHROMA_DIR=./var/chroma
AI_CHECKPOINT_DB=./var/checkpoints.sqlite

# 한 번의 Agent 실행에서 허용하는 최대 도구 호출 수.
AI_MAX_TOOL_CALLS=12
